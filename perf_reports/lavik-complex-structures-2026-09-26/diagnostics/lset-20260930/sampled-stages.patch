diff --git a/src/storage/engine/lset_profile.h b/src/storage/engine/lset_profile.h
new file mode 100644
index 00000000..208c1f80
--- /dev/null
+++ b/src/storage/engine/lset_profile.h
@@ -0,0 +1,74 @@
+#pragma once
+
+// Temporary diagnostic only: owner-local, sampled coroutine wall times.
+// This header is not part of the optimization PR or its benchmark binary.
+#include <unistd.h>
+
+#include <array>
+#include <chrono>
+#include <cstdio>
+
+namespace lavik::storage::lset_profile {
+enum Stage {
+  Total,
+  EntryLock,
+  Prepare,
+  ReadTarget,
+  Commit,
+  Dependency,
+  Pressure,
+  SecondDependency,
+  AppendPages,
+  AppendRoot,
+  Count
+};
+inline constexpr const char* names[] = {
+    "total",        "entry_lock", "prepare",  "read_target",
+    "commit",       "dependency", "pressure", "second_dependency",
+    "append_pages", "append_root"};
+struct Counter {
+  unsigned long long calls = 0, samples = 0, ns = 0, max_ns = 0;
+};
+struct Counters {
+  std::array<Counter, Count> values{};
+  ~Counters() {
+    for (unsigned i = 0; i < Count; ++i) {
+      const auto& c = values[i];
+      if (c.calls)
+        std::fprintf(stderr,
+                     "LSET_PROFILE tid=%d stage=%s calls=%llu samples=%llu "
+                     "ns=%llu max_ns=%llu\n",
+                     int(::gettid()), names[i], c.calls, c.samples, c.ns,
+                     c.max_ns);
+    }
+  }
+};
+inline thread_local Counters counters;
+class Scope {
+ public:
+  Scope(Stage stage, bool enabled = true) {
+    if (!enabled) return;
+    auto& c = counters.values[stage];
+    if (++c.calls % 127 == 1) {
+      counter_ = &c;
+      start_ = std::chrono::steady_clock::now();
+    }
+  }
+  void Finish() {
+    if (!counter_) return;
+    const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                        std::chrono::steady_clock::now() - start_)
+                        .count();
+    ++counter_->samples;
+    counter_->ns += ns;
+    if (static_cast<unsigned long long>(ns) > counter_->max_ns)
+      counter_->max_ns = ns;
+    counter_ = nullptr;
+  }
+  ~Scope() { Finish(); }
+
+ private:
+  Counter* counter_ = nullptr;
+  std::chrono::steady_clock::time_point start_{};
+};
+}  // namespace lavik::storage::lset_profile
